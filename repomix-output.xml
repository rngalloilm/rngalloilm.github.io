          <div className="param">
            <h3 className="h3-report">Cone Genetic ID</h3>
            <p>{cone.geneticId}</p>
          </div>
          <div className="param">
            <h3 className="h3-report">Cone ID</h3>
            <p>{props.id}</p>
          </div>
          <div className="param">
            <h3 className="h3-report">Parent IDs</h3>
            <p>Mother ID: {cone.motherTreeId || "--"}</p>        
            <p>Father ID: {cone.fatherTreeId || "--"}</p>        
