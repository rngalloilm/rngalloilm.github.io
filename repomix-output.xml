        assertTrue(it.hasNext());
        assertEquals(v2, it.next());
        assertTrue(it.hasNext());
        assertEquals(v3, it.next());
        assertTrue(it.hasNext());
        assertEquals(v4, it.next());
        assertTrue(it.hasNext());
        assertEquals(v5, it.next());
        assertTrue(it.hasNext());
        assertEquals(v6, it.next());
        assertFalse(it.hasNext());
    }

