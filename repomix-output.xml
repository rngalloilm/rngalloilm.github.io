      width: 170,
    },
    {
      field: "species",
      headerName: "Species",
      width: 130,
    },
    {
      field: "location",
      headerName: "Location",
      width: 130,
    },
    {
      field: "gps",
      headerName: "GPS",
      width: 180,
    },
  ];


 

  return (
    <div>
