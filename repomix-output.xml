<file path="docs/projects/Node-WebApps/MiniProject1/Part2/css/style.css">
/* =====================
   General Resets
===================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: sans-serif;
    color: #333;
  }
  
  /* =====================
     Layout
  ===================== */
  html, body {
    height: 100%;
  }
  
  /* 
    Main container:
    The body has two children:
    aside.sidebar and section.main-content
  
    We'll use a flex container to place the sidebar on the left
    and the main content on the right.
  */
  body {
    display: flex;
    flex-direction: row;
  }
  
  /* =====================
     Sidebar
  ===================== */
  .sidebar {
    width: 250px;
    background-color: #f5f5f5;
    display: flex;
    flex-direction: column;
  }
  .sidebar-logo {
    padding: 1rem;
    text-align: center;
    background-color: black;
    color: white;
  }
  .sidebar-logo img {
    max-width: 100%;
    height: auto;
  }
  .sidebar-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .user-account {
    display: flex;
    align-items: center;
    padding: 1rem;
  }
  .user-account img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    margin-right: 0.5rem;
  }
  .sidebar-nav {
    padding: 0 1rem;
  }
  .sidebar-nav a {
    display: block;
    padding: 0.5rem 0;
    text-decoration: none;
    color: #555;
  }
  .sidebar-nav a:hover {
    color: #111;
  }
  .sub-nav {
    padding-left: 1rem;
    margin-bottom: 1rem;
  }
  .sub-nav a {
    font-size: 0.9rem;
  }
  .sidebar-footer {
    padding: 1rem;
    border-top: 1px solid #ccc;
  }
  .sidebar-footer a {
    margin-right: 1rem;
    text-decoration: none;
    color: #555;
  }
  
  /* =====================
     Main Content
  ===================== */
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  
  /* Header */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background-color: #ececec;
  }
  .header-left {
    display: flex;
    align-items: center;
  }
  .greeting {
    margin-right: 2rem;
    font-weight: bold;
  }
  .search-form {
    position: relative;
  }
  .search-form input {
    padding: 0.5rem;
  }
  
  /* Right side icons / dropdowns */
  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header-right button{
    font-size: 1.5rem;
    padding: 0.5rem;
  }
  .dropdown {
    position: relative;
  }
  .dropdown-toggle {
    cursor: pointer;
    background: none;
    border: none;
  }
  
  /* Hide dropdown menu by default */
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 2rem;
    right: 0;
    background: white;
    border: 1px solid #ccc;
    padding: 1rem;
    min-width: 150px;
  }
  
  /* Show dropdown on :hover or :focus-within */
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    display: block;
  }
  
  /* Badge for message counts */
  .badge {
    background: red;
    color: #fff;
    border-radius: 50%;
    padding: 0 6px;
    margin-left: 4px;
    font-size: 0.8rem;
  }
  
  /* =====================
     Dashboard Layout
  ===================== */
  .dashboard {
    padding: 1rem;
    flex: 1;
    overflow-y: auto;
  }
  
  /* Info boxes (4 columns in a grid) */
  .info-boxes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .info-box {
    background: #fafafa;
    border: 1px solid #ddd;
    padding: 1rem;
    border-radius: 4px;
  }
  
  /* Generic card style */
  .card {
    background: #fafafa;
    border: 1px solid #ddd;
    margin-bottom: 2rem;
    padding: 1rem;
    border-radius: 4px;
  }
  
  /* Grid for the location info and the map side-by-side */
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  
  /* Charts Grid (Impressions and Traffic side by side) */
  .charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .chart-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .chart-image img {
    max-width: 100%;
    height: auto;
  }
  
  /* Stats grid (2/3 + 1/3 or 50/50) */
  .stats-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
  }
  
  /* Misc spacing and headings */
  .card-subtitle, .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-header h4 {
    margin-bottom: 0.5rem;
  }
</file>

