/* Basic reset */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

/* Parent container to hold both the calculator and the history side by side */
.app-container {
  display: flex;
  justify-content: center;   /* Centers the blocks horizontally */
  align-items: flex-start;   /* Aligns them at the top */
  gap: 20px;                 /* Adds space between the calculator and history blocks */
  margin: 50px;
}

/* Calculator container styling */
.calculator-container {
  max-width: 400px;
  padding: 10px;
  border: 2px solid #444;
  border-radius: 10px;
  background: #f9f9f9;
}

/* History container styling (now a separate block) */
.history-container {
  width: 200px;           /* Fixed width for the history block */
  padding: 10px;
  border: 2px solid #444;
  border-radius: 10px;
  background: #f9f9f9;
}

/* Display styling */
.display-container {
  margin-bottom: 10px;
}

.display {
  width: 100%;
  height: 60px;
  font-size: 2rem;
  text-align: right;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 5px;
}

/* Buttons container using CSS Grid */
.buttons-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-gap: 10px;
  margin-bottom: 15px;
}

.btn {
  padding: 20px;
  font-size: 1.2rem;
  border: none;
  border-radius: 5px;
  background: #e0e0e0;
  cursor: pointer;
  transition: background 0.2s; /* Smooth background color transition on hover */
}

.btn:hover {
  background: #d0d0d0;
}

/* Special styling for operator buttons */
.operator {
  background: #ff9500;
  color: white;
}

.operator:hover {
  background: #e08900;
}

/* Clear and equals button styling */
.clear {
  background: #ff3b30;
  color: white;
}

.clear:hover {
  background: #e33229;
}

.equals {
  background: #34c759;
  color: white;
}

.equals:hover {
  background: #2fae50;
}

/* Plus-minus button styling */
.plus-minus {
  background: #8e8e93;
  color: white;
}

.plus-minus:hover {
  background: #7a7a85;
}

/* History section styling */
.history-container h3 {
  margin-bottom: 10px;
  text-align: center;
}

#history-list {
  list-style: none;
  max-height: 150px;
  overflow-y: auto;
  padding-left: 5px;
  margin-bottom: 10px;
}

#history-list li {
  padding: 5px;
  border-bottom: 1px solid #ddd;
  cursor: pointer;
}

#history-list li:hover {
  background: #f0f0f0;
}

#clear-history {
  width: 100%;
  padding: 10px;
  background: #555;
  color: #fff;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

#clear-history:hover {
  background: #444;
}
