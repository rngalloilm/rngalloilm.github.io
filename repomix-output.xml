  font-family: 'Roboto', sans-serif;
  margin: 0;
  padding: 0;
}

/* Header */
header {
  background-color: #990000; /* Red */
  color: white;
  padding: 1em;
  margin-bottom: 20px;
}

header h1 {
  margin: 0;
}

/* Navigation */
nav {
  background-color: #990000; /* Red */
  padding: 1em;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  margin: 10px 0;
}

nav ul li a {
  color: white;
  text-decoration: none;
  background-color: #427E93; /* Blue */
  padding: 10px 20px;
  border-radius: 5px;
}

nav ul li a:hover {
  background-color: #35677d; /* Darker Blue */
}

/* Buttons */
#logoutButton,
