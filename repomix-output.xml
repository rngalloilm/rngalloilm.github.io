					reset = false;
				}
			} else if (e.getSource() == btnReject) {
				int idx = comboRejectionReason.getSelectedIndex();
				
				if (idx == -1) {
					reset = false;
					JOptionPane.showMessageDialog(WolfHireGUI.this, "No rejection reason selected");
