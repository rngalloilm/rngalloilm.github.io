          value={population ? population : ""}
        />
        {isPopulationFormOpen &&
          <PopulationForm 
            isOpen={isPopulationFormOpen}
            onClose={handleClosePopulationForm}
            addPopOption={addPopulationOption}
            operation={"add"}
          />
        }
        {isGeneticIdFormOpen && 
          <GeneticIdForm
