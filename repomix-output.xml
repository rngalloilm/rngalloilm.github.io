						JOptionPane.showMessageDialog(WolfHireGUI.this, "Invalid command");
						reset = false;
					} catch (UnsupportedOperationException uoe) {
						JOptionPane.showMessageDialog(WolfHireGUI.this, "Invalid state transition");
						reset = false;
					}
				}
			}
