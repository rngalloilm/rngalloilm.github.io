          {/* <div className="param">
            <h3 className="h3-report">Progeny ID</h3>
            <p>{cone.progenyId || "--"}</p>
          </div> */}
          <div className="param">
            <h3 className="h3-report">Date Harvest</h3>
            <p>{cone.dateHarvested}</p>
          </div>
          <div className="param">
            <h3 className="h3-report">Location</h3>
