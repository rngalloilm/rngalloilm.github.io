            res.statusCode = 200;
            res.statusMessage = 'OK';
            res.send(innerRes);
          } else {
            res.sendStatus(404);
          }
        }).catch((error) => {
          console.log("Unexpected Error in retrieving photos. ", error);
          res.send(500);
        });
      } else {
        console.log(" Id: " + materialId + " not found");
        res.sendStatus(404);
      }
    });
    
    // Add photo to material
