		const selectedImage = imageList.length > 0 ? imageList[0] : null;
		console.log(imageList, addUpdateIndex);
		// Call the parent component's function to pass the selected image
		props.onImageSelect(selectedImage);
		setImages(imageList);
	};

  return (
    <div className="App">
